# ==========================================================
# Face Identification & Blockchain Verification Pipeline Config
# ==========================================================

# 1. SerpApi Key (For Google Lens Reverse Image Search)
# Sign up for free at https://serpapi.com (100 free searches/month, no credit card needed)
SERPAPI_API_KEY=your_serpapi_key_here

# 2. Blockchain Configuration
# For Ethereum Sepolia Testnet:
#   RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#   or Alchemy/Infura URL: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# For Local Node (e.g., Hardhat / Anvil):
#   RPC_URL=http://127.0.0.1:8545
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 3. Web3 Wallet Private Key (MUST be a burner test account, NEVER use a real wallet!)
# e.g., 0xabcdef...
WALLET_PRIVATE_KEY=your_testnet_private_key_here

# 4. Deployed PostRegistry Smart Contract Address
# Run `python -m chain_module.deployer` to automatically deploy and obtain an address.
CONTRACT_ADDRESS=
